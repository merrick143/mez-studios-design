{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.mez.systems/schemas/product.schema.json",
  "title": "Mez Systems product",
  "type": "object",
  "additionalProperties": false,
  "required": ["productId", "slug", "publicName", "function", "availability", "summary", "gradientId", "identityState"],
  "properties": {
    "productId": {"type": "string", "pattern": "^mz\\.systems\\.product\\.[a-z0-9-]+$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "publicName": {"type": "string", "minLength": 1},
    "function": {"type": "string", "minLength": 1},
    "availability": {"enum": ["live", "coming-soon", "retired"]},
    "summary": {"type": "string", "minLength": 1},
    "gradientId": {"type": "string", "pattern": "^MZ-G[0-9]{2,3}$"},
    "identityState": {"enum": ["locked", "provisional", "retired"]}
  }
}
