{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.mez.systems/schemas/release.schema.json",
  "title": "Mez Systems release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "version", "stage", "cutoverId", "authorityState", "canonicalSnapshot", "productionReady", "decisions", "contents"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "releaseId": {"type": "string", "pattern": "^mz\\.systems\\.release\\."},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$"},
    "stage": {"const": "migration-snapshot"},
    "cutoverId": {"type": "string", "pattern": "^CUTOVER-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "authorityState": {"enum": ["prepared", "canonical-active"]},
    "canonicalSnapshot": {"type": "boolean"},
    "productionReady": {"const": false},
    "decisions": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "contents": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
