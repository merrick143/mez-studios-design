  "policies": {
    "gradient": "Product gradients remain identity objects. Never use a Living Core or gradient as a page wash, generic accent, text fill, status colour or decorative infrastructure.",
    "functionalColour": "Blue, green, amber and red exist only for links, focus, selection and explicit feedback. The default state surface stays neutral; tinted emphasis is reserved for critical banners. Pair every state with text, iconography or structure so colour is never the sole signal.",
    "dark": "Dark is a contained inverse room for bundles, technical detail and deliberate contrast. Do not auto-convert the complete brand experience into a dark theme.",
    "email": "Use opaque sRGB values and preserve hierarchy if client dark-mode transformations occur. Never depend on a webfont, blend mode, transparency or background image for meaning.",
    "document": "Prefer white pages, economical recessed fills and explicit rules. Embed values in export adapters rather than relying on screen colour profiles.",
    "print": "Collapse functional hues to grayscale, retain labels or symbols, and avoid large near-black coverage where a rule or heading provides enough hierarchy.",
    "forcedColours": "Map canvas, text, buttons, links and focus to system colours. Preserve borders and never suppress forced-colour adjustment on semantic controls."
  },
  "testViewports": [320, 375, 768, 1280, 1440]
