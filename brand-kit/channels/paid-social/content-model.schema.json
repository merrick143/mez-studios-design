{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/paid-social-price-anchored-product-proof-1.0.0.json",
  "title": "Paid-social price-anchored product-proof content",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatId", "product", "audience", "categoryAnchor", "productPrice", "firstStepCopy", "productProof", "outcomeCards", "variation", "provenance"],
  "properties": {
    "formatId": {"const": "mz.systems.format.paid-social.price-anchored-product-proof"},
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["productId", "publicName", "destination"],
      "properties": {"productId": {"type": "string", "pattern": "^mz\\.systems\\.product\\."}, "publicName": {"type": "string", "minLength": 2}, "destination": {"type": "string", "format": "uri"}}
    },
    "audience": {"type": "string", "minLength": 8, "maxLength": 120},
    "categoryAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "amountText", "evidenceUrls", "verifiedAt", "scopeNote"],
      "properties": {"headline": {"type": "string", "minLength": 8, "maxLength": 70}, "amountText": {"type": "string", "pattern": "^\\$"}, "evidenceUrls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}, "uniqueItems": true}, "verifiedAt": {"type": "string", "format": "date"}, "scopeNote": {"type": "string", "minLength": 12}}
    },
    "productPrice": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "currency", "billing", "sourceUrl", "verifiedAt"],
      "properties": {"amount": {"type": "number", "exclusiveMinimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "billing": {"enum": ["one-time", "monthly", "annual", "other"]}, "sourceUrl": {"type": "string", "format": "uri"}, "verifiedAt": {"type": "string", "format": "date"}}
    },
    "firstStepCopy": {"type": "string", "minLength": 8, "maxLength": 70},
    "productProof": {
      "type": "object", "additionalProperties": false,
      "required": ["captureId", "assetPath", "assetClass", "privacyStatus", "proofRole", "treatment"],
      "properties": {"captureId": {"type": "string"}, "assetPath": {"type": "string"}, "assetClass": {"enum": ["native-capture", "supplied-composition"]}, "privacyStatus": {"enum": ["internal", "redaction-required", "public-safe-candidate", "approved-public"]}, "proofRole": {"type": "string", "minLength": 12}, "treatment": {"enum": ["native", "near-native", "device-composition"]}}
    },
    "outcomeCards": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false, "required": ["headline", "supporting", "icon"], "properties": {"headline": {"type": "string", "minLength": 3, "maxLength": 34}, "supporting": {"type": "string", "minLength": 3, "maxLength": 48}, "icon": {"enum": ["notion-mark", "ai-os-disc"]}}}
    },
    "variation": {
      "type": "object", "additionalProperties": false,
      "required": ["glow", "titleMark", "inlineLabel", "proofTreatment"],
      "properties": {"glow": {"enum": ["cool-cyan-overhead", "warm-amber-upper-left", "violet-upper-right", "neutral-downlight", "dual-blue-cyan-low"]}, "titleMark": {"enum": ["ai-os-disc-wings", "ai-os-disc", "notion-mark"]}, "inlineLabel": {"enum": ["notion", "ai-os-disc-text"]}, "proofTreatment": {"enum": ["native", "device-composition"]}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["createdAt", "createdBy", "sourceFrameId", "publicUseApproved"],
      "properties": {"createdAt": {"type": "string", "format": "date-time"}, "createdBy": {"type": "string"}, "sourceFrameId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}, "publicUseApproved": {"type": "boolean"}}
    }
  }
}
