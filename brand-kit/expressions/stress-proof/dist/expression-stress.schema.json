{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://design.mez.systems/schemas/expression-stress-proof-1.0.0.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","proofId","version","status","productionAuthority","gateId","candidateRevision","taskId","decisionIds","title","thesis","authorityBoundary","coverage","suites","scenarios","acceptance","approval","dependencies"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "proofId":{"const":"mz.systems.expression.stress-proof"},
    "version":{"const":"1.0.0"},
    "status":{"const":"canonical"},
    "productionAuthority":{"const":true},
    "gateId":{"const":"H-EXP-08-EXPRESSION-STRESS-PROOF"},
    "candidateRevision":{"const":"expression-stress-01-r01"},
    "taskId":{"const":"TASK-EXP-08-EXPRESSION-STRESS-PROOF"},
    "decisionIds":{"type":"array","contains":{"const":"DEC-EXPRESSION-STRESS-CERTIFICATION-001"},"items":{"type":"string"},"uniqueItems":true},
    "title":{"type":"string","minLength":10},
    "thesis":{"type":"string","minLength":120},
    "authorityBoundary":{"type":"object","required":["mayCertify","mayRepair","mayNotChange"]},
    "coverage":{"type":"object","required":["viewports","containers","textZoom","contentModes","runtimeModes","inputModes"]},
    "suites":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["id","title","count","passRule"],"properties":{"id":{"enum":["reflow","content","fallback","accessibility","recovery","invariants"]},"title":{"type":"string"},"count":{"type":"integer","minimum":1},"passRule":{"type":"string","minLength":20}}}},
    "scenarios":{"type":"array","minItems":14,"maxItems":14,"items":{"type":"object","additionalProperties":false,"required":["id","suite","title","fixture","automatedChecks"],"properties":{"id":{"pattern":"^ST-[RTFASI][0-9]{2}$"},"suite":{"enum":["reflow","content","fallback","accessibility","recovery","invariants"]},"title":{"type":"string"},"fixture":{"type":"string"},"automatedChecks":{"type":"array","minItems":3,"items":{"type":"string"},"uniqueItems":true}}}},
    "acceptance":{"type":"object","required":["automatic","visual","human","consumerBoundary"]},
    "approval":{"type":"object","additionalProperties":false,"required":["review","decisionId","approvedSuites","approvedScenarios","reviewedAt"],"properties":{"review":{"const":"brand-kit/expressions/stress-proof/review.json"},"decisionId":{"const":"DEC-EXPRESSION-STRESS-CERTIFICATION-001"},"approvedSuites":{"const":6},"approvedScenarios":{"const":14},"reviewedAt":{"type":"string","format":"date-time"}}},
    "dependencies":{"type":"object","required":["disc","sphere","wingsMark","productCard","productComponents","tradingCard","websiteMotion","foundationManifest","productRegistry","gradientRegistry","wings"]}
  }
}
