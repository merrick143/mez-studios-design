  "title": "Expression system stress proof",
  "thesis": "EXP-08 certifies that the approved Mez expression grammar remains complete, legible and operable under hostile receiver, content, preference, input and runtime conditions. It may expose implementation defects, but it cannot silently redesign or reopen approved expression decisions.",
  "authorityBoundary": {
    "mayCertify": ["responsive reflow", "text growth and localization", "reduced-motion and static equivalence", "keyboard, focus and semantic operation", "missing media, unavailable data and recoverable errors", "one-live-core allocation and source-order invariants"],
    "mayRepair": ["overflow", "truncation", "focus loss", "missing labels", "fallback failure", "motion-preference failure", "recovery failure"],
    "mayNotChange": ["approved visual direction", "canonical product or gradient assignment", "Wings geometry", "component anatomy", "motion grammar", "golden-homepage composition", "global-navigation anatomy"]
  },
  "coverage": {
    "viewports": [320, 360, 375, 390, 430, 768, 1024, 1280, 1440],
    "containers": [240, 320, 480, 640, 960, 1160],
    "textZoom": [100, 200, 400],
    "contentModes": ["short", "long", "localized", "rtl", "missing-optional", "unpriced"],
    "runtimeModes": ["default", "reduced-motion", "no-webgl", "missing-media", "forced-colours"],
    "inputModes": ["keyboard", "pointer", "touch", "screen-reader-spot-check"]
  },
  "suites": [
    {"id":"reflow","title":"Receiver and reflow","count":3,"passRule":"No page or component overflow, clipping, overlap or unusable control at the named viewport and receiver widths."},
    {"id":"content","title":"Content and zoom","count":3,"passRule":"Reading order, hierarchy and actions remain complete at 200/400 percent text scale, long copy, translation expansion and RTL."},
    {"id":"fallback","title":"Motion and fallback","count":3,"passRule":"Static is complete; reduced motion avoids renderer initialization; no-WebGL and missing-media states preserve identity and meaning."},
    {"id":"accessibility","title":"Accessibility and input","count":2,"passRule":"Semantic controls, visible focus, keyboard order, target size and non-colour state meaning remain intact."},
    {"id":"recovery","title":"Async and recovery","count":2,"passRule":"Loading, failure, retry, missing optional data and unpriced offers remain truthful and recoverable."},
    {"id":"invariants","title":"System invariants","count":1,"passRule":"One live product material maximum; repeated siblings are static; canonical identity, geometry and source order do not drift."}
  ],
