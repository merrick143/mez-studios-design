{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.mez.systems/schemas/product-card-contract-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expressionId", "version", "status", "productionAuthority", "candidateGateId", "candidateRevision", "programme", "supersedes", "designThesis", "cardArchitecture", "sharedContent", "postures", "expressions", "territories", "agentRecommendation", "surfaceStrategy", "coreAllocation", "editions", "phaseBScope", "accessibility", "dependencies", "reviewSurface", "testViewports"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "expressionId": {"const": "mz.systems.expression.product-card"},
    "version": {"const": "1.0.0"},
    "status": {"const": "canonical-visual-grammar"},
    "productionAuthority": {"const": true},
    "candidateGateId": {"const": "H-EXP-04A-CARD-VISUAL-DIRECTION"},
    "candidateRevision": {"const": "product-card-02-phase-a-r10"},
    "programme": {"type": "object", "required": ["name", "sequenceRule", "phaseA", "phaseB"]},
    "supersedes": {"type": "array", "minItems": 11},
    "designThesis": {"type": "string", "minLength": 180},
    "cardArchitecture": {"type": "object", "required": ["name", "widthRange", "ratio", "fixedSlots", "variableMedia", "familyRule"]},
    "sharedContent": {"type": "object", "required": ["source", "rule", "actionByAvailability"]},
    "postures": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["id", "name", "treatment", "job", "rule", "minimum"]}},
    "expressions": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["id", "name", "role", "placement", "thesis", "motion", "variants", "failure"]}},
    "territories": {"type": "object", "required": ["rule", "assignments", "default"]},
    "agentRecommendation": {"type": "object", "required": ["base", "reason", "challengers", "boundedRoles", "rejected"]},
    "surfaceStrategy": {"type": "object", "required": ["calmShelf", "focalContrast", "darkIntegration", "rule"]},
    "coreAllocation": {"type": "object", "required": ["maximumLivePerViewport", "liveAllowed", "staticRequired", "fallback", "finish"]},
    "editions": {"type": "object", "required": ["active", "disposition", "owner"], "properties": {"active": {"const": false}, "disposition": {"const": "removed-from-product-card-02-round-10"}, "owner": {"type": "string"}}},
    "phaseBScope": {"type": "object", "required": ["status", "startsAfter", "websiteComponents", "websiteFlows", "states", "contracts"]},
    "accessibility": {"type": "object"},
    "dependencies": {"type": "object"},
    "reviewSurface": {"type": "object", "required": ["route", "sections"]},
    "testViewports": {"const": [320, 375, 430, 768, 1024, 1280, 1440]}
  }
}
