{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/task.schema.json",
  "title": "Mez Systems bounded task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","taskId","title","phase","status","owner","scope","dependencies","inputs","deliverables","verification","humanGate","stopConditions"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "taskId": {"type":"string","pattern":"^TASK-[A-Z0-9-]+$"},
    "title": {"type":"string","minLength":3},
    "phase": {"type":"integer","minimum":0,"maximum":8},
    "status": {"enum":["ready","in-progress","blocked","awaiting-human","complete"]},
    "owner": {"type":"string","minLength":1},
    "objective": {"type":"string"},
    "scope": {
      "type":"object","additionalProperties":false,"required":["included","excluded"],
      "properties":{"included":{"type":"array","items":{"type":"string"},"minItems":1},"excluded":{"type":"array","items":{"type":"string"}}}
    },
    "dependencies": {"type":"array","items":{"type":"string","pattern":"^(TASK|DEC|DS)-[A-Z0-9-]+$"},"uniqueItems":true},
    "inputs": {
      "type":"object","additionalProperties":false,"required":["requiredFiles","decisionIds","artifactIds","consumerIds"],
      "properties": {
        "requiredFiles":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "decisionIds":{"type":"array","items":{"type":"string","pattern":"^DEC-[A-Z0-9-]+$"},"uniqueItems":true},
        "artifactIds":{"type":"array","items":{"type":"string","pattern":"^ART-[A-F0-9]{12}$"},"uniqueItems":true},
        "consumerIds":{"type":"array","items":{"type":"string","pattern":"^CON-[A-Z0-9-]+$"},"uniqueItems":true}
      }
    },
    "deliverables": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","acceptance"],"properties":{"path":{"type":"string"},"acceptance":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
    "verification": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","method","passCondition"],"properties":{"id":{"type":"string"},"method":{"enum":["command","schema","visual","human","manual-inspection"]},"command":{"type":"string"},"passCondition":{"type":"string"}}}},
    "humanGate": {"type":"object","additionalProperties":false,"required":["required","gateId","approver","approvalQuestion"],"properties":{"required":{"type":"boolean"},"gateId":{"type":["string","null"]},"approver":{"type":["string","null"]},"approvalQuestion":{"type":["string","null"]}}},
    "stopConditions": {"type":"array","minItems":1,"items":{"type":"string"}},
    "notes": {"type":"array","items":{"type":"string"}}
  }
}
