{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/identity-product-object-01-review.schema.json",
  "title": "Mez identity and product-object calibration review",
  "type": "object",
  "required": ["schemaVersion", "studyId", "exportedAt", "productionAuthority", "sourceExpressionApproved", "record"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "studyId": {"const": "MEZ-IDENTITY-PRODUCT-OBJECT-01"},
    "exportedAt": {"type": "string", "format": "date-time"},
    "productionAuthority": {"const": false},
    "sourceExpressionApproved": {"const": false},
    "sourceGradient": {"const": "MZ-G13"},
    "record": {
      "type": "object",
      "required": ["decisions", "overallNote", "productionAuthority"],
      "properties": {
        "decisions": {
          "type": "object",
          "required": ["canonicalCore", "scaleSystem", "motionBehaviour"],
          "properties": {
            "canonicalCore": {"$ref": "#/$defs/decision"},
            "scaleSystem": {"$ref": "#/$defs/decision"},
            "motionBehaviour": {"$ref": "#/$defs/decision"}
          },
          "additionalProperties": false
        },
        "overallNote": {"type": "string"},
        "productionAuthority": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["decision", "note"],
      "properties": {
        "decision": {"enum": ["lock", "edit", "reject"]},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
