{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/hero-first-viewport-03-review.schema.json",
  "title": "Mez hero and first viewport calibration 03 review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studyId", "exportedAt", "complete", "productionAuthority", "sourceExpressionApproved", "decisions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "studyId": {"const": "MEZ-HERO-FIRST-VIEWPORT-03"},
    "exportedAt": {"type": "string", "format": "date-time"},
    "complete": {"type": "boolean"},
    "productionAuthority": {"const": false},
    "sourceExpressionApproved": {"const": false},
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overallDirection", "messageHierarchy", "cardStackComposition", "animationUse", "productFamilyRead", "mobileOpening"],
      "properties": {
        "overallDirection": {"$ref": "#/$defs/decision"},
        "messageHierarchy": {"$ref": "#/$defs/decision"},
        "cardStackComposition": {"$ref": "#/$defs/decision"},
        "animationUse": {"$ref": "#/$defs/decision"},
        "productFamilyRead": {"$ref": "#/$defs/decision"},
        "mobileOpening": {"$ref": "#/$defs/decision"}
      }
    },
    "overallNote": {"type": "string"}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "note"],
      "properties": {
        "decision": {"enum": ["approve", "edit", "reject"]},
        "note": {"type": "string"}
      }
    }
  }
}
