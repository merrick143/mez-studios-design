{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/homepage-foundation-review.schema.json",
  "title": "Mez Systems homepage foundation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "studyId",
    "exportedAt",
    "productionAuthority",
    "sourceExpressionApproved",
    "contentSource",
    "records"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "studyId": {"const": "MEZ-HOMEPAGE-FOUNDATION-STUDIO-01"},
    "exportedAt": {"type": "string", "format": "date-time"},
    "productionAuthority": {"const": false},
    "sourceExpressionApproved": {"const": false},
    "contentSource": {"const": "Notion page 8bb570a0-f71a-4e42-9243-e9aa9e760733"},
    "records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction", "note"],
      "properties": {
        "reaction": {"enum": ["keep", "change", "too much", "too plain", "not Mez"]},
        "note": {"type": "string", "maxLength": 1000}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studyId", "studyName", "overall", "note", "annotations", "productionAuthority"],
      "properties": {
        "studyId": {"enum": ["layered-clarity", "kinetic-shelf", "system-ledger", "soft-infrastructure"]},
        "studyName": {"enum": ["Layered clarity", "Kinetic shelf", "System ledger", "Soft infrastructure"]},
        "overall": {"enum": ["", "promising", "useful details", "not Mez"]},
        "note": {"type": "string", "maxLength": 2000},
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hero": {"$ref": "#/$defs/annotation"},
            "problem": {"$ref": "#/$defs/annotation"},
            "ethos": {"$ref": "#/$defs/annotation"},
            "proof": {"$ref": "#/$defs/annotation"},
            "aios": {"$ref": "#/$defs/annotation"},
            "shelf": {"$ref": "#/$defs/annotation"},
            "commerce": {"$ref": "#/$defs/annotation"},
            "final": {"$ref": "#/$defs/annotation"}
          }
        },
        "productionAuthority": {"const": false}
      }
    }
  }
}
