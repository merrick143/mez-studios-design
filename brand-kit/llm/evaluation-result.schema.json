{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/evaluation-result.schema.json",
  "title": "Mez Systems evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","evaluationId","receiptId","evaluatedAt","evaluator","contractChecks","qualityDimensions","blockers","verdict"],
  "properties": {
    "schemaVersion":{"const":"1.0.0"},
    "evaluationId":{"type":"string","pattern":"^EVAL-[A-Z0-9-]+$"},
    "receiptId":{"type":"string","pattern":"^RCP-[A-Z0-9-]+$"},
    "evaluatedAt":{"type":"string","format":"date-time"},
    "evaluator":{"type":"object","additionalProperties":false,"required":["kind","name"],"properties":{"kind":{"enum":["human","llm","hybrid","automated"]},"name":{"type":"string"}}},
    "contractChecks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","status","evidence"],"properties":{"id":{"type":"string"},"status":{"enum":["pass","fail","warning","not-applicable"]},"evidence":{"type":"string"}}}},
    "qualityDimensions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","score","maximum","evidence"],"properties":{"id":{"type":"string"},"score":{"type":"number","minimum":0},"maximum":{"type":"number","exclusiveMinimum":0},"evidence":{"type":"string"}}}},
    "blockers":{"type":"array","items":{"type":"string"}},
    "verdict":{"enum":["pass","pass-with-warnings","changes-required","blocked","reject"]},
    "humanReviewRequired":{"type":"boolean"},
    "notes":{"type":"array","items":{"type":"string"}}
  }
}
