{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/context-bundle.schema.json",
  "title": "Mez Systems context bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","bundleId","taskId","generatedAt","systemVersion","sourceState","files","decisions","artifacts","consumers","knownConflicts","stopConditions","contextBudget"],
  "properties": {
    "schemaVersion":{"const":"1.0.0"},
    "bundleId":{"type":"string","pattern":"^CTX-[A-Z0-9-]+$"},
    "taskId":{"type":"string","pattern":"^TASK-[A-Z0-9-]+$"},
    "generatedAt":{"type":"string","format":"date-time"},
    "systemVersion":{"type":"string","minLength":1},
    "sourceState":{"type":"object","additionalProperties":false,"required":["repository","branch","commit","workingTree"],"properties":{"repository":{"type":"string"},"branch":{"type":"string"},"commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"workingTree":{"enum":["clean","dirty"]}}},
    "files":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","role","required"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"role":{"enum":["canonical","governance","evidence","fixture","mirror","legacy","research"]},"required":{"type":"boolean"},"reason":{"type":"string"}}}},
    "decisions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","productionEffect"],"properties":{"id":{"type":"string","pattern":"^DEC-[A-Z0-9-]+$"},"status":{"type":"string"},"productionEffect":{"type":"string"}}}},
    "artifacts":{"type":"array","items":{"type":"string","pattern":"^ART-[A-F0-9]{12}$"},"uniqueItems":true},
    "consumers":{"type":"array","items":{"type":"string","pattern":"^CON-[A-Z0-9-]+$"},"uniqueItems":true},
    "knownConflicts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","summary","executionEffect"],"properties":{"id":{"type":"string"},"summary":{"type":"string"},"executionEffect":{"enum":["inform","constrain","stop"]}}}},
    "stopConditions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "contextBudget":{"type":"object","additionalProperties":false,"required":["strategy","requiredFirst","omitByDefault"],"properties":{"strategy":{"enum":["bounded","full-pack"]},"requiredFirst":{"type":"array","items":{"type":"string"}},"omitByDefault":{"type":"array","items":{"type":"string"}}}},
    "humanNotes":{"type":"array","items":{"type":"string"}}
  }
}
