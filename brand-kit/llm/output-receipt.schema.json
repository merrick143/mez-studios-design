{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mez.systems/schemas/output-receipt.schema.json",
  "title": "Mez Systems output receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","receiptId","taskId","contextBundleId","agent","startedAt","finishedAt","outcome","filesChanged","decisionsApplied","tests","artifactsProduced","assumptions","exceptions","hiddenContextFailures","humanStatus","nextAction"],
  "properties": {
    "schemaVersion":{"const":"1.0.0"},
    "receiptId":{"type":"string","pattern":"^RCP-[A-Z0-9-]+$"},
    "taskId":{"type":"string","pattern":"^TASK-[A-Z0-9-]+$"},
    "contextBundleId":{"type":"string","pattern":"^CTX-[A-Z0-9-]+$"},
    "agent":{"type":"object","additionalProperties":false,"required":["kind","name"],"properties":{"kind":{"enum":["human","llm","hybrid"]},"name":{"type":"string"},"model":{"type":["string","null"]}}},
    "startedAt":{"type":"string","format":"date-time"},
    "finishedAt":{"type":"string","format":"date-time"},
    "outcome":{"enum":["complete","partial","blocked","failed"]},
    "filesChanged":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","action","sha256"],"properties":{"path":{"type":"string"},"action":{"enum":["created","modified","deleted","generated"]},"sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"reason":{"type":"string"}}}},
    "decisionsApplied":{"type":"array","items":{"type":"string","pattern":"^DEC-[A-Z0-9-]+$"},"uniqueItems":true},
    "tests":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","evidence"],"properties":{"id":{"type":"string"},"status":{"enum":["pass","fail","not-run","not-applicable"]},"evidence":{"type":"string"}}}},
    "artifactsProduced":{"type":"array","items":{"type":"string"}},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "exceptions":{"type":"array","items":{"type":"string"}},
    "hiddenContextFailures":{"type":"array","items":{"type":"string"}},
    "humanStatus":{"type":"object","additionalProperties":false,"required":["gateRequired","gateId","status"],"properties":{"gateRequired":{"type":"boolean"},"gateId":{"type":["string","null"]},"status":{"enum":["not-required","pending","approved","changes-requested","rejected"]}}},
    "nextAction":{"type":"string"}
  }
}
