{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/gradient-maker.py": {
      "maxDuration": 30,
      "excludeFiles": "{.venv,node_modules,reviews,play-orb,directory-previews,brand-kit/{workspace,assets,history,releases,references,golden,components,expressions,foundations,channels}}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
